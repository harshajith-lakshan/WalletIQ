// WalletIQ Firestore Security Rules
// Version: 1.0
// Status: PRODUCTION-READY
// Last Updated: August 21, 2026

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isResourceOwner(field) {
      return request.auth.uid == resource.data[field];
    }
    
    function isRequestOwner(field) {
      return request.auth.uid == request.resource.data[field];
    }
    
    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // User can read/write only their own document
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Enforce data structure on write
      allow write: if isAuthenticated() && isOwner(userId) && 
        request.resource.data.keys().hasAll(['email']) &&
        request.resource.data.email is string;
      
      // Prevent uid modification
      allow write: if isAuthenticated() && isOwner(userId) &&
        !('uid' in request.resource.data.keys());
      
      // ========================================
      // TRANSACTIONS SUBCOLLECTION
      // ========================================
      match /transactions/{transactionId} {
        // User can read/write only their own transactions
        allow read, write: if isAuthenticated() && isOwner(userId);
        
        // Validate required fields
        allow create: if isAuthenticated() && isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'type', 'amount', 'category', 'wallet', 'date', 'timestamp'
          ]) &&
          request.resource.data.type in ['income', 'expense', 'transfer', 'loan_received', 'loan_given', 'loan_repayment', 'refund', 'adjustment'] &&
          request.resource.data.amount > 0 &&
          request.resource.data.amount is number &&
          request.resource.data.timestamp is timestamp;
        
        // Allow updates to non-sensitive fields
        allow update: if isAuthenticated() && isOwner(userId) &&
          request.resource.data.timestamp == resource.data.timestamp;
        
        // Allow delete
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // ========================================
      // ATTACHMENTS SUBCOLLECTION
      // ========================================
      match /attachments/{attachmentId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
        
        allow create: if isAuthenticated() && isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'transactionId', 'url', 'type', 'createdAt'
          ]) &&
          request.resource.data.type in ['receipt', 'invoice', 'proof'] &&
          request.resource.data.createdAt is timestamp;
        
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // ========================================
    // LOANS COLLECTION
    // ========================================
    match /loans/{loanId} {
      // User can read their own loans
      allow read: if isAuthenticated() && isResourceOwner('userId');
      
      // User can create loan for themselves
      allow create: if isAuthenticated() && isRequestOwner('userId') &&
        request.resource.data.keys().hasAll([
          'userId', 'person', 'type', 'totalAmount', 'paidAmount', 'dueDate', 'createdAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ['lent', 'borrowed'] &&
        request.resource.data.totalAmount > 0 &&
        request.resource.data.paidAmount >= 0 &&
        request.resource.data.paidAmount <= request.resource.data.totalAmount &&
        request.resource.data.createdAt is timestamp;
      
      // User can update their own loans
      allow update: if isAuthenticated() && isResourceOwner('userId') &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt;
      
      // User can delete their own loans
      allow delete: if isAuthenticated() && isResourceOwner('userId');
      
      // ========================================
      // LOAN PAYMENTS SUBCOLLECTION
      // ========================================
      match /payments/{paymentId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid;
        
        allow create: if isAuthenticated() && 
          get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'amount', 'date', 'timestamp'
          ]) &&
          request.resource.data.amount > 0 &&
          request.resource.data.timestamp is timestamp;
        
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid;
      }
    }
    
    // ========================================
    // DENY ALL OTHER COLLECTIONS BY DEFAULT
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
